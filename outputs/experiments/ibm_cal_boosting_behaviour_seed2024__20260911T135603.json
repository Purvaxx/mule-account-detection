      "params": {
        "origins": [
          "2022-09-05",
          "2022-09-07",
          "2022-09-09"
        ],
        "horizon_days": 2,
        "lookback_days": null,
        "max_label_end": "2022-09-11"
      },
      "seed": 2024
    },
    "model": {
      "family": "gradient_boosting",
      "params": {
        "backend": "auto",
        "n_estimators": 300,
        "learning_rate": 0.05,
        "max_depth": 6
      },
      "imbalance": "class_weight"
    },
    "threshold": {
