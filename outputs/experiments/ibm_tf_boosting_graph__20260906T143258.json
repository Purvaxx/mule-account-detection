        "aml_network_v1",
        "aml_cycle_v1"
      ],
      "scope": "train_window"
    },
    "split": {
      "strategy": "time_forward_holdout",
      "params": {
        "train_quantile": 0.6,
        "val_quantile": 0.8,
        "time_reference": "last"
      },
      "seed": 42
    },
    "model": {
      "family": "gradient_boosting",
      "params": {
        "backend": "auto",
        "n_estimators": 300,
        "learning_rate": 0.05,
        "max_depth": 6
      },
      "imbalance": "class_weight"
    },
    "threshold": {
      "strategy": "alert_budget",
