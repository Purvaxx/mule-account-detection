{
  "name": "ibm_logistic_aml",
  "description": "L2 logistic regression on the full AML feature set. Interpretable supervised reference.",
  "tags": [
    "baseline",
    "linear",
    "ibm"
  ],
  "seed": 42,
  "dataset": {
    "name": "ibm_aml_hi_small",
    "version": "resolved-at-run-time",
    "provenance": "file:HI-Small_Trans.csv",
    "label_definition": "positive = the (bank, account) entity appears on at least one transaction flagged Is Laundering",
    "synthetic": true
  },
  "features": {
    "sets": [
      "aml_txn_v1",
      "aml_temporal_v1",
      "aml_flow_v1",
      "aml_context_v1",
      "aml_network_v1",
      "aml_cycle_v1"
    ],
    "scope": "global"
  },
  "split": {
    "strategy": "stratified_kfold",
    "params": {
      "n_folds": 4
    },
    "seed": 42
  },
  "model": {
    "family": "logistic_regression",
    "params": {
      "C": 1.0,
      "max_iter": 2000
    },
    "imbalance": "class_weight"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "platt",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      100,
      500,
      1000,
      5000
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.05
    ],
    "calibration_bins": 10
  }
}
