{
  "name": "time_forward_boosting",
  "description": "The operational question: train only on transactions that had already happened, and score entities the model meets later. Numbers here are not comparable with the transductive configs.",
  "tags": [
    "operational",
    "time-aware"
  ],
  "seed": 42,
  "dataset": {
    "name": "reference_dkdata",
    "version": "resolved-at-run-time",
    "provenance": "file:../dkdata.json",
    "label_definition": "positive = graph node attribute 'core' is True",
    "synthetic": false
  },
  "features": {
    "sets": [
      "aml_core_v1"
    ],
    "scope": "train_window"
  },
  "split": {
    "strategy": "time_forward_rolling",
    "params": {
      "n_folds": 3,
      "initial_quantile": 0.5,
      "time_reference": "first"
    },
    "seed": 42
  },
  "model": {
    "family": "gradient_boosting",
    "params": {
      "backend": "auto",
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 4
    },
    "imbalance": "class_weight"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "none",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      10,
      20,
      50,
      100
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.05
    ],
    "calibration_bins": 10
  }
}
