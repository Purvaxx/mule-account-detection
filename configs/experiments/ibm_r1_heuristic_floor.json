{
  "name": "ibm_r1_heuristic_floor",
  "description": "The label-free floor under the calendar-forward regime. R1 cross-period detection transfer: fit on a completed 2-day detection window, freeze, and score the next window. Features and labels both come from the window being scored - retrospective detection, not forecasting.",
  "tags": [
    "unsupervised",
    "ibm",
    "r1",
    "detection-transfer"
  ],
  "seed": 42,
  "dataset": {
    "name": "ibm_aml_hi_small",
    "version": "resolved-at-run-time",
    "provenance": "file:HI-Small_Trans.csv",
    "label_definition": "positive = the (bank, account) entity is payer or payee of at least one transaction flagged Is Laundering inside the detection window the entity is scored for (detection_transfer; features come from the same window)",
    "synthetic": true
  },
  "features": {
    "sets": [
      "aml_txn_v1",
      "aml_temporal_v1",
      "aml_flow_v1",
      "aml_context_v1",
      "aml_network_v1",
      "aml_cycle_v1"
    ],
    "scope": "detection_window"
  },
  "split": {
    "strategy": "detection_transfer",
    "params": {
      "windows": [
        [
          "W1",
          "2022-09-03",
          "2022-09-05"
        ],
        [
          "W2",
          "2022-09-05",
          "2022-09-07"
        ],
        [
          "W3",
          "2022-09-07",
          "2022-09-09"
        ],
        [
          "W4",
          "2022-09-09",
          "2022-09-11"
        ]
      ],
      "partition": {
        "fit": 0.6,
        "val": 0.2,
        "in_period": 0.2
      },
      "max_window_end": "2022-09-11",
      "min_positives": 500
    },
    "seed": 42
  },
  "model": {
    "family": "structural_heuristic",
    "params": {
      "signals": [
        [
          "pass_through_ratio",
          1
        ],
        [
          "fan_in",
          1
        ],
        [
          "fan_out",
          1
        ],
        [
          "reciprocal_ratio",
          1
        ],
        [
          "txn_per_active_day",
          1
        ],
        [
          "burstiness",
          1
        ],
        [
          "min_in_to_out_hours",
          -1
        ],
        [
          "counterparty_diversity",
          1
        ],
        [
          "layering_share",
          1
        ],
        [
          "rapid_turnover_share",
          1
        ]
      ]
    },
    "imbalance": "none"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "none",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      100,
      500,
      1000,
      5000
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.02,
      0.05
    ],
    "calibration_bins": 10
  }
}
