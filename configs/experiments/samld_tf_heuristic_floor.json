{
  "name": "samld_tf_heuristic_floor",
  "description": "The label-free floor under the same time-forward, training-window regime.",
  "tags": [
    "unsupervised",
    "time-forward",
    "samld"
  ],
  "seed": 42,
  "dataset": {
    "name": "samld",
    "version": "resolved-at-run-time",
    "provenance": "file:SAML-D.csv.zip",
    "label_definition": "positive = the account appears on at least one transaction flagged Is_laundering",
    "synthetic": true
  },
  "features": {
    "sets": [
      "aml_txn_v1",
      "aml_temporal_v1",
      "aml_flow_v1",
      "aml_context_v1",
      "aml_network_v1",
      "aml_cycle_v1"
    ],
    "scope": "train_window"
  },
  "split": {
    "strategy": "time_forward_holdout",
    "params": {
      "train_quantile": 0.6,
      "val_quantile": 0.8,
      "time_reference": "last"
    },
    "seed": 42
  },
  "model": {
    "family": "structural_heuristic",
    "params": {
      "signals": [
        [
          "pass_through_ratio",
          1
        ],
        [
          "fan_in",
          1
        ],
        [
          "fan_out",
          1
        ],
        [
          "reciprocal_ratio",
          1
        ],
        [
          "txn_per_active_day",
          1
        ],
        [
          "burstiness",
          1
        ],
        [
          "min_in_to_out_hours",
          -1
        ],
        [
          "counterparty_diversity",
          1
        ],
        [
          "layering_share",
          1
        ],
        [
          "rapid_turnover_share",
          1
        ]
      ]
    },
    "imbalance": "none"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "none",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      100,
      500,
      1000,
      5000
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.05
    ],
    "calibration_bins": 10
  }
}
