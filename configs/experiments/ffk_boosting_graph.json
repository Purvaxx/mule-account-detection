{
  "name": "ffk_boosting_graph",
  "description": "Control: gradient boosting on the full AML feature set, same dataset. If this lands far below 1.0 while SAML-D saturates, the difference is the data, not the protocol.",
  "tags": [
    "control",
    "trees",
    "card-fraud"
  ],
  "seed": 42,
  "dataset": {
    "name": "financial_fraud_kaggle",
    "version": "resolved-at-run-time",
    "provenance": "file:financial_fraud_detection_dataset.csv",
    "label_definition": "positive = the account appears on at least one transaction flagged is_fraud (card-not-present fraud, not laundering)",
    "synthetic": true
  },
  "features": {
    "sets": [
      "aml_txn_v1",
      "aml_temporal_v1",
      "aml_flow_v1",
      "aml_context_v1",
      "aml_network_v1",
      "aml_cycle_v1"
    ],
    "scope": "global"
  },
  "split": {
    "strategy": "stratified_kfold",
    "params": {
      "n_folds": 4
    },
    "seed": 42
  },
  "model": {
    "family": "gradient_boosting",
    "params": {
      "backend": "auto",
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 6
    },
    "imbalance": "class_weight"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "platt",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      100,
      500,
      1000,
      5000
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.05
    ],
    "calibration_bins": 10
  }
}
