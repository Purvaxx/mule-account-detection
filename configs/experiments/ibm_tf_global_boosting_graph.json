{
  "name": "ibm_tf_global_boosting_graph",
  "description": "Time-forward split with GLOBAL feature scope. Isolates the split effect from the feature-scope effect: ibm_boosting_graph changes both at once.",
  "tags": [
    "diagnostic",
    "time-forward",
    "global-scope",
    "ibm"
  ],
  "seed": 42,
  "dataset": {
    "name": "ibm_aml_hi_small",
    "version": "resolved-at-run-time",
    "provenance": "file:HI-Small_Trans.csv",
    "label_definition": "positive = the (bank, account) entity appears on at least one transaction flagged Is Laundering",
    "synthetic": true
  },
  "features": {
    "sets": [
      "aml_txn_v1",
      "aml_temporal_v1",
      "aml_flow_v1",
      "aml_context_v1",
      "aml_network_v1",
      "aml_cycle_v1"
    ],
    "scope": "global"
  },
  "split": {
    "strategy": "time_forward_holdout",
    "params": {
      "train_quantile": 0.6,
      "val_quantile": 0.8,
      "time_reference": "last"
    },
    "seed": 42
  },
  "model": {
    "family": "gradient_boosting",
    "params": {
      "backend": "auto",
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 6
    },
    "imbalance": "class_weight"
  },
  "threshold": {
    "strategy": "alert_budget",
    "params": {
      "rate": 0.01
    }
  },
  "calibration": {
    "method": "platt",
    "min_val_positives": 20
  },
  "evaluation": {
    "k_values": [
      100,
      500,
      1000,
      5000
    ],
    "alert_rates": [
      0.001,
      0.005,
      0.01,
      0.05
    ],
    "calibration_bins": 10
  }
}
